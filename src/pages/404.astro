---
// Halaman 404 kustom. Ditandai noindex agar tidak masuk indeks,
// tapi tetap menawarkan jalan kembali supaya pengunjung tidak hilang
// (mengurangi pogo-sticking, sinyal negatif untuk SEO).
import Layout from '../layouts/Layout.astro';
import { waLink } from '../config';

const links = [
  { href: '/#solusi', label: 'Solusi' },
  { href: '/#fitur', label: 'Fitur' },
  { href: '/#harga', label: 'Harga' },
  { href: '/#faq', label: 'FAQ' },
];
---

<Layout
  title="Halaman tidak ditemukan (404) | ChatHub"
  description="Halaman yang Anda cari tidak tersedia. Kembali ke beranda ChatHub untuk melihat solusi omnichannel, AI chatbot, dan Smart CRM."
  canonicalPath="/404"
  noindex
>
  <main id="konten" class="flex min-h-svh flex-col items-center justify-center px-4 py-16 text-center">
    <p class="text-sm font-extrabold tracking-widest text-brand-600 uppercase">Error 404</p>
    <h1 class="mt-3 text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl">
      Halaman ini tidak ditemukan
    </h1>
    <p class="mt-4 max-w-md text-base text-slate-600">
      Mungkin tautannya salah ketik atau halamannya sudah dipindahkan. Chat bisnis Anda tetap bisa kami bantu rapikan.
    </p>

    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <a
        href="/"
        class="inline-flex items-center justify-center rounded-xl bg-brand-600 px-7 py-3.5 text-base font-bold text-white shadow-lg shadow-brand-600/25 transition-colors duration-200 hover:bg-brand-700"
      >
        Kembali ke beranda
      </a>
      <a
        href={waLink('Halo tim ChatHub, saya ingin konsultasi & demo untuk bisnis saya.')}
        data-track-name="404 - Konsultasi"
        target="_blank"
        rel="noopener"
        class="inline-flex items-center justify-center rounded-xl border-2 border-brand-600 bg-white px-7 py-3.5 text-base font-bold text-brand-600 transition-colors duration-200 hover:bg-brand-600 hover:text-white"
      >
        Tanya via WhatsApp
      </a>
    </div>

    <nav class="mt-10" aria-label="Tautan cepat">
      <ul class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-sm font-semibold text-slate-600">
        {
          links.map((l) => (
            <li>
              <a href={l.href} class="transition-colors duration-200 hover:text-brand-600">
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </main>
</Layout>
