---
import { waLink } from '../config';

const steps = [
  {
    title: 'Hubungkan semua channel Anda',
    desc: 'WhatsApp, Instagram, Facebook, Telegram, email, live chat website, tim kami bantu setup dalam 1 hari kerja.',
    icon: 'M13.19 8.688a4.5 4.5 0 0 1 1.242 7.244l-4.5 4.5a4.5 4.5 0 0 1-6.364-6.364l1.757-1.757m13.35-.622 1.757-1.757a4.5 4.5 0 0 0-6.364-6.364l-4.5 4.5a4.5 4.5 0 0 0 1.242 7.244',
  },
  {
    title: 'AI otomatis balas & saring prospek',
    desc: 'Chatbot menjawab FAQ dari basis pengetahuan bisnis Anda sendiri, memilah mana yang serius mau beli, dan mengoper ke tim saat perlu sentuhan manusia.',
    icon: 'M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09ZM18.259 8.715 18 9.75l-.259-1.035a3.375 3.375 0 0 0-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 0 0 2.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 0 0 2.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 0 0-2.456 2.456Z',
  },
  {
    title: 'Tim closing dengan data yang rapi',
    desc: 'Semua prospek tercatat di pipeline, reminder follow-up jalan otomatis, dan Anda pantau konversinya real-time.',
    icon: 'M2.25 18 9 11.25l4.306 4.306a11.95 11.95 0 0 1 5.814-5.518l2.74-1.22m0 0-5.94-2.281m5.94 2.28-2.28 5.941',
  },
];
---

<section class="flex md:min-h-[calc(100svh-4rem)] flex-col justify-center bg-slate-50 py-10 md:py-12 lg:py-14" id="cara-kerja" data-snap>
  <div class="mx-auto w-full max-w-7xl px-4 sm:px-6">
    <div class="mx-auto max-w-2xl text-center" data-reveal>
      <h2 class="text-2xl font-extrabold tracking-tight text-slate-900 sm:text-3xl lg:text-4xl">Mulai dalam 3 langkah</h2>
      <p class="mt-3 text-base text-slate-600 sm:text-lg">Tidak perlu paham teknis, semua dibantu tim onboarding.</p>
    </div>
    <ol class="mt-10 grid gap-8 md:grid-cols-3" data-reveal-group>
      {
        steps.map((s, i) => (
          <li class="relative rounded-2xl border border-slate-200 bg-white p-6 text-center">
            <span class="absolute -top-4 left-1/2 flex h-8 w-8 -translate-x-1/2 items-center justify-center rounded-full bg-brand-600 text-sm font-extrabold text-white">
              {i + 1}
            </span>
            <span class="mx-auto mt-3 flex h-14 w-14 items-center justify-center rounded-2xl bg-brand-50">
              <svg class="h-7 w-7 text-brand-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d={s.icon} />
              </svg>
            </span>
            <h3 class="mt-4 text-lg font-bold text-slate-900">{s.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-600">{s.desc}</p>
          </li>
        ))
      }
    </ol>

    <!-- Mini-CTA kontekstual: setup dibantu → langsung minta demo -->
    <div class="mt-8 text-center" data-reveal>
      <a
        href={waLink('Halo tim ChatHub, saya mau mulai, setup 1 hari kerja. Bisa dibantu prosesnya?')}
        data-track-name="HowItWorks - Mulai"
        target="_blank"
        rel="noopener"
        class="cta-main inline-flex items-center justify-center gap-2 rounded-xl bg-brand-600 px-6 py-3.5 text-sm font-bold text-white shadow-lg shadow-brand-600/20 hover:bg-brand-700 sm:text-base"
      >
        Setup dibantu tim, chat sekarang
      </a>
    </div>
  </div>
</section>
