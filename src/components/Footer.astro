---
import { waLink } from '../config';
const year = new Date().getFullYear();
---

<footer class="border-t border-slate-100 bg-slate-50 py-10">
  <div class="mx-auto flex max-w-7xl flex-col items-center gap-4 px-4 text-center sm:px-6">
    <div class="flex items-center gap-2">
      <svg class="h-7 w-7" viewBox="0 0 32 32" aria-hidden="true">
        <rect width="32" height="32" rx="8" fill="#C00000"></rect>
        <path d="M16 7c-5 0-9 3.6-9 8 0 2.5 1.3 4.7 3.3 6.2L9 25.5l4.6-1.6c.8.2 1.6.3 2.4.3 5 0 9-3.6 9-8s-4-8.2-9-8.2z" fill="#fff"></path>
        <circle cx="12" cy="15" r="1.4" fill="#C00000"></circle>
        <circle cx="16" cy="15" r="1.4" fill="#C00000"></circle>
        <circle cx="20" cy="15" r="1.4" fill="#FFC107"></circle>
      </svg>
      <span class="font-extrabold tracking-tight">Chat<span class="text-brand-600">Hub</span></span>
    </div>
    <p class="max-w-md text-sm text-slate-500">
      Platform Omnichannel + AI Chatbot + Smart CRM oleh PT Chat Hub Indonesia.
    </p>
    <a href={waLink('Halo tim ChatHub, saya ingin konsultasi & demo untuk bisnis saya.')} data-track-name="Footer - Konsultasi" target="_blank" rel="noopener" class="text-sm font-semibold text-brand-600 transition-colors duration-200 hover:text-brand-700">
      Hubungi kami via WhatsApp
    </a>
    <p class="text-xs text-slate-400">© {year} PT Chat Hub Indonesia. Seluruh hak cipta dilindungi.</p>
  </div>
</footer>
