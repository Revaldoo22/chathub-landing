---
import { waLink } from '../config';

const problems = [
  {
    title: 'Uang hilang diam-diam',
    desc: 'Chat yang telat dibalas atau terlewat = calon pembeli pindah ke kompetitor. Anda bahkan tidak tahu berapa nominal yang hilang tiap bulan.',
    icon: 'M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z',
  },
  {
    title: 'Tim kewalahan buka-tutup aplikasi',
    desc: 'WA di HP satu, DM Instagram di HP lain, Messenger di laptop. Admin sibuk pindah-pindah aplikasi, respon makin lambat.',
    icon: 'M2.25 12.76c0 1.6 1.123 2.994 2.707 3.227 1.087.16 2.185.283 3.293.369V21l4.076-4.076a1.526 1.526 0 0 1 1.037-.443 48.282 48.282 0 0 0 5.68-.494c1.584-.233 2.707-1.626 2.707-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0 0 12 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018Z',
  },
  {
    title: 'Follow-up bocor',
    desc: 'Leads yang sudah tanya-tanya lupa di-follow-up karena tidak ada pengingat. Closing yang harusnya jadi, hilang begitu saja.',
    icon: 'M12 9v3.75m9-.75a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 3.75h.008v.008H12v-.008Z',
  },
  {
    title: 'Owner tidak punya visibilitas',
    desc: 'Siapa yang belum dibalas? Prospek mana yang hampir closing? Semua ada di kepala admin, tidak tercatat rapi di mana pun.',
    icon: 'M3.98 8.223A10.477 10.477 0 0 0 1.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.451 10.451 0 0 1 12 4.5c4.756 0 8.773 3.162 10.065 7.498a10.522 10.522 0 0 1-4.293 5.774M6.228 6.228 3 3m3.228 3.228 3.65 3.65m7.894 7.894L21 21m-3.228-3.228-3.65-3.65m0 0a3 3 0 1 0-4.243-4.243m4.242 4.242L9.88 9.88',
  },
  {
    title: 'Nambah admin = biaya naik, tetap tidak 24 jam',
    desc: 'Rekrut lebih banyak orang itu mahal, dan manusia tetap butuh tidur. Chat yang masuk jam 11 malam tetap menunggu sampai pagi.',
    icon: 'M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z',
  },
];
---

<section class="flex md:min-h-[calc(100svh-4rem)] flex-col justify-center bg-slate-50 py-10 md:py-12 lg:py-14" id="masalah" data-snap>
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <div class="mx-auto max-w-2xl text-center" data-reveal>
      <h2 class="text-2xl font-extrabold tracking-tight text-slate-900 sm:text-3xl lg:text-4xl">
        Kenali tanda-tandanya. <span class="text-brand-600">Ini terjadi tiap hari.</span>
      </h2>
      <p class="mt-3 text-base text-slate-600 sm:text-lg">
        Kalau salah satu saja terasa familiar, bisnis Anda sedang membocorkan omzet tanpa disadari.
      </p>
    </div>

    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" data-reveal-group>
      {
        problems.map((p, i) => (
          <div class="rounded-2xl border border-slate-200 bg-white p-5 transition-shadow duration-200 hover:shadow-md">
            <div class="flex items-start justify-between">
              <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-brand-50">
                <svg class="h-5 w-5 text-brand-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d={p.icon} />
                </svg>
              </span>
              <span class="text-3xl font-extrabold text-slate-100 select-none" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            </div>
            <h3 class="mt-3 text-base font-bold text-slate-900">{p.title}</h3>
            <p class="mt-1.5 text-sm leading-relaxed text-slate-600">{p.desc}</p>
          </div>
        ))
      }
      <div class="flex items-center rounded-2xl bg-brand-600 p-5 text-white">
        <p class="text-base leading-relaxed font-semibold sm:text-lg">
          Anda sudah bayar iklan untuk mendatangkan setiap chat itu. Setiap chat yang tidak
          direspon berarti <strong class="text-accent-300">biaya akuisisi yang terbuang percuma</strong>.
        </p>
      </div>
    </div>

    <!-- Mini-CTA kontekstual -->
    <div class="mt-8 text-center" data-reveal>
      <a
        href={waLink('Halo tim ChatHub, saya sering kehilangan chat & lead yang telat dibalas. Boleh dibantu solusinya?')}
        data-track-name="Problems - Solusi"
        target="_blank"
        rel="noopener"
        class="cta-main inline-flex items-center justify-center gap-2 rounded-xl bg-brand-600 px-6 py-3.5 text-sm font-bold text-white shadow-lg shadow-brand-600/20 hover:bg-brand-700 sm:text-base"
      >
        Stop kehilangan chat, coba gratis sekarang
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12l-7.5 7.5M21 12H3"/></svg>
      </a>
    </div>
  </div>
</section>
