---
import { waLink, STATS } from '../config';

const channels = [
  { name: 'WhatsApp', color: '#25D366', initial: 'WA' },
  { name: 'Instagram', color: '#E1306C', initial: 'IG' },
  { name: 'Facebook', color: '#1877F2', initial: 'FB' },
  { name: 'Telegram', color: '#229ED9', initial: 'TG' },
  { name: 'Email', color: '#64748B', initial: '@' },
  { name: 'Live Chat', color: '#C00000', initial: 'LC' },
];
---

<section id="hero" data-snap class="relative flex md:min-h-[calc(100svh-4rem)] flex-col overflow-hidden bg-white">
  <div class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_top_right,#fdf2f2_0%,transparent_55%)]" aria-hidden="true"></div>
  <div class="mx-auto grid max-w-7xl flex-1 items-center gap-8 px-4 py-8 sm:px-6 lg:grid-cols-2 lg:gap-14">
    <!-- Copy -->
    <div data-reveal>
      <p class="mb-4 inline-flex items-center gap-2 rounded-full bg-brand-50 px-3 py-1 text-xs font-bold tracking-wide text-brand-700 uppercase">
        <span class="h-1.5 w-1.5 rounded-full bg-brand-600" aria-hidden="true"></span>
        Omnichannel · AI Chatbot · Smart CRM
      </p>
      <h1 class="text-3xl leading-tight font-extrabold tracking-tight text-slate-900 sm:text-4xl lg:text-[2.75rem]">
        Setiap Chat yang Telat Dibalas Adalah <span class="text-brand-600">Uang yang Hilang</span>
      </h1>
      <p class="mt-4 max-w-xl text-base leading-relaxed text-slate-600">
        ChatHub menyatukan chat dari WhatsApp, Instagram, Facebook, Telegram, dan email ke satu layar
       , lalu AI membalasnya otomatis dalam hitungan detik, 24 jam sehari. Tim Anda tinggal fokus closing.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a
          href={waLink('Halo tim ChatHub, saya mau coba gratis. Bisa dibantu untuk mulai?')}
          data-track-name="Hero - Coba Gratis"
          target="_blank"
          rel="noopener"
          class="cta-main cta-pulse inline-flex items-center justify-center gap-2 rounded-xl bg-brand-600 px-7 py-4 text-base font-bold text-white shadow-lg shadow-brand-600/25 hover:bg-brand-700 hover:shadow-xl hover:shadow-brand-600/30"
        >
          Coba Gratis Sekarang
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12l-7.5 7.5M21 12H3"/></svg>
        </a>
        <a
          href={waLink('Halo tim ChatHub, saya ingin konsultasi & demo untuk bisnis saya.')}
          data-track-name="Hero - Konsultasi"
          target="_blank"
          rel="noopener"
          class="inline-flex items-center justify-center gap-2 rounded-xl border-2 border-wa-500 bg-white px-7 py-4 text-base font-bold text-wa-600 transition-colors duration-200 hover:bg-wa-500 hover:text-white"
        >
          <svg class="h-5 w-5 fill-current" viewBox="0 0 24 24" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          Konsultasi via WhatsApp
        </a>
      </div>
      <p class="mt-3 text-sm text-slate-500">Tanpa kartu kredit · Setup 1 hari kerja · Termasuk onboarding &amp; support</p>
    </div>

    <!-- Mockup unified inbox -->
    <div class="relative hidden sm:block" aria-hidden="true" data-reveal style="--rd: 120ms">
      <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-2xl shadow-slate-300/40">
        <div class="mb-3 flex items-center justify-between border-b border-slate-100 pb-3">
          <div class="flex items-center gap-2">
            <span class="h-2.5 w-2.5 rounded-full bg-brand-600"></span>
            <span class="text-sm font-bold text-slate-800">Inbox Terpadu</span>
          </div>
          <span class="rounded-full bg-green-100 px-2 py-0.5 text-xs font-semibold text-green-700">AI Aktif 24/7</span>
        </div>
        <ul class="space-y-2.5">
          {
            [
              { ch: channels[0], name: 'Ibu Sari', msg: 'Kak, ready stok warna merah?', time: 'baru saja', ai: true },
              { ch: channels[1], name: 'dimas.store', msg: 'Berapa ongkir ke Surabaya?', time: '1 mnt', ai: true },
              { ch: channels[2], name: 'Rudi Hartono', msg: 'Bisa kirim penawaran harga?', time: '3 mnt', ai: false },
              { ch: channels[3], name: 'Klinik Sehat', msg: 'Jadwal dokter besok masih ada?', time: '5 mnt', ai: true },
            ].map((c) => (
              <li class="flex items-center gap-3 rounded-xl border border-slate-100 bg-slate-50/60 p-3">
                <span
                  class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full text-[10px] font-bold text-white"
                  style={`background:${c.ch.color}`}
                >
                  {c.ch.initial}
                </span>
                <span class="min-w-0 flex-1">
                  <span class="flex items-center justify-between gap-2">
                    <span class="truncate text-sm font-semibold text-slate-800">{c.name}</span>
                    <span class="shrink-0 text-[11px] text-slate-400">{c.time}</span>
                  </span>
                  <span class="block truncate text-xs text-slate-500">{c.msg}</span>
                </span>
                {c.ai ? (
                  <span class="shrink-0 rounded-md bg-brand-50 px-1.5 py-0.5 text-[10px] font-bold text-brand-600">AI ✓</span>
                ) : (
                  <span class="shrink-0 rounded-md bg-accent-400/20 px-1.5 py-0.5 text-[10px] font-bold text-amber-700">Agent</span>
                )}
              </li>
            ))
          }
        </ul>
        <div class="mt-3 grid grid-cols-3 gap-2 border-t border-slate-100 pt-3 text-center">
          <div class="rounded-lg bg-slate-50 p-2">
            <p class="text-sm font-extrabold text-brand-600">2 dtk</p>
            <p class="text-[10px] text-slate-500">Respon rata-rata</p>
          </div>
          <div class="rounded-lg bg-slate-50 p-2">
            <p class="text-sm font-extrabold text-brand-600">0</p>
            <p class="text-[10px] text-slate-500">Chat terlewat</p>
          </div>
          <div class="rounded-lg bg-slate-50 p-2">
            <p class="text-sm font-extrabold text-brand-600">Multi channel</p>
            <p class="text-[10px] text-slate-500">Satu dashboard</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Indikator scroll: sinyal ada konten lanjutan -->
  <a
    href="#masalah"
    class="mx-auto mb-3 flex h-11 w-11 items-center justify-center rounded-full text-brand-600 transition-colors duration-200 hover:bg-brand-50"
    aria-label="Scroll ke bagian berikutnya"
  >
    <svg class="scroll-hint h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
    </svg>
  </a>

  <!-- Trust bar -->
  <div class="border-y border-slate-100 bg-slate-50/70">
    <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-center gap-x-10 gap-y-2 px-4 py-4 text-sm font-semibold text-slate-600 sm:px-6">
      <span><strong class="text-brand-600">{STATS.businesses}</strong> bisnis aktif</span>
      <span class="hidden text-slate-300 sm:inline" aria-hidden="true">·</span>
      <span><strong class="text-brand-600">{STATS.messages}</strong> pesan diproses / bulan</span>
      <span class="hidden text-slate-300 sm:inline" aria-hidden="true">·</span>
      <span><strong class="text-brand-600">{STATS.uptime}</strong> uptime SLA</span>
    </div>
  </div>
</section>
